{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "../src/core/**/*.ts",
    "../scripts/**/*.ts"
  ]
}
